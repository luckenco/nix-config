#!/usr/bin/env bash
set -euo pipefail

# Avoid caller-directory config discovery; inherited environment is unchanged.
cd "$HOME"
export BUN_INSTALL="${BUN_INSTALL:-${XDG_CACHE_HOME:-$HOME/.cache}/.bun}"
failed=()

update() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "$1 not found; skipping"
    return
  fi

  printf '\nUpdating:'
  printf ' %s' "$@"
  printf '\n'
  if "$@"; then
    return
  fi
  echo "Update failed: $*" >&2
  failed+=("$*")
}

# Update CLI packages before their extensions.
update bun update --global --latest
update npm update --global
update uv tool upgrade --all
update rustup update
update origin update
update prime-agent update
update amp update
update sentry cli upgrade
update pi update --extensions
update mas upgrade

# Taps are pinned by the flake and refreshed by the switch stage.
export HOMEBREW_NO_AUTO_UPDATE=1
update brew upgrade --yes

if ((${#failed[@]})); then
  printf '\nFailed updates:\n' >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi
