#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

package_file="pkgs/bun-latest.nix"
version="$(curl -fsSL https://api.github.com/repos/oven-sh/bun/releases/latest |
  jq -er '.tag_name | ltrimstr("bun-v")')"
if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "Invalid Bun stable version: $version" >&2
  exit 1
fi

current_version="$(sed -n 's/^[[:space:]]*version = "\([^"]*\)";$/\1/p' "$package_file")"
current_hash="$(sed -n 's/^[[:space:]]*hash = "\([^"]*\)";$/\1/p' "$package_file")"
if [[ "$current_version" == "$version" && "$current_hash" =~ ^sha256-[A-Za-z0-9+/]+={0,2}$ ]]; then
  echo "Bun already pinned at $version"
  exit 0
fi

export BUN_VERSION="$version"
BUN_HASH="$(nix store prefetch-file --json \
  "https://github.com/oven-sh/bun/releases/download/bun-v${version}/bun-darwin-aarch64.zip" |
  jq -er '.hash | select(type == "string" and test("^sha256-[A-Za-z0-9+/]+={0,2}$"))')"
export BUN_HASH

tmp="$(mktemp "${package_file}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
cp -p "$package_file" "$tmp"
perl -0pi -e '
  s/version = "[^"]+";/version = "$ENV{BUN_VERSION}";/ or die "Missing version pin\n";
  s/hash = "[^"]*";/hash = "$ENV{BUN_HASH}";/ or die "Missing hash pin\n";
' "$tmp"
mv "$tmp" "$package_file"
trap - EXIT

echo "Pinned Bun $version in $package_file"
