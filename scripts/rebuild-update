#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Older aliases passed both the repository path and host.
host="${2:-mbp}"
if [[ $# -eq 1 && "$1" != */* ]]; then
  host="$1"
fi

exec just \
  --justfile "$repo_root/justfile" \
  --working-directory "$repo_root" \
  rebuild-update "$host"
