#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
export HOME="$tmp/home" TEST_LOG="$tmp/log"
unset DRY_RUN
mkdir -p "$tmp/bin" "$HOME" "$tmp/project"

cat >"$tmp/bin/uv" <<'SH'
#!/bin/bash
set -eu
[[ "$*" == 'tool install prime' && "$PWD" == "$HOME" ]]
[[ "$UV_TOOL_BIN_DIR" == "$HOME/.local/bin" ]]
echo uv >>"$TEST_LOG"
mkdir -p "$UV_TOOL_BIN_DIR"
printf '#!/bin/sh\nexit 0\n' >"$UV_TOOL_BIN_DIR/prime"
chmod +x "$UV_TOOL_BIN_DIR/prime"
SH
cat >"$tmp/bin/curl" <<'SH'
#!/bin/bash
set -eu
[[ "$*" == *'https://raw.githubusercontent.com/PrimeIntellect-ai/prime-agent/main/install-rust.sh'* ]]
echo curl >>"$TEST_LOG"
[[ "${TEST_DOWNLOAD_FAIL:-0}" == 0 ]] || exit 1
while [[ "$1" != -o ]]; do shift; done
cat >"$2" <<'INSTALL'
set -eu
[ "$PRIME_AGENT_RUST_PREFIX" = "$HOME/.local" ]
printf '#!/bin/sh\nexit 0\n' >"$PRIME_AGENT_RUST_PREFIX/bin/prime-agent"
chmod +x "$PRIME_AGENT_RUST_PREFIX/bin/prime-agent"
echo installer >>"$TEST_LOG"
INSTALL
SH
chmod +x "$tmp/bin/"*
export PATH="$tmp/bin:$PATH" TMPDIR="$tmp"
cd "$tmp/project"

# Dry runs must not invoke a package manager or create user files.
DRY_RUN='' bash "$repo_root/scripts/install-prime"
[[ ! -e "$TEST_LOG" && ! -e "$HOME/.local" ]]
if [[ -n "${ACTIVATE_PRIME:-}" ]]; then
  bash -c 'DRY_RUN=""; source "$ACTIVATE_PRIME"'
  [[ ! -e "$HOME/.local" ]]
fi

bash "$repo_root/scripts/install-prime"
[[ "$(wc -l <"$TEST_LOG" | tr -d '[:space:]')" == 3 ]]
[[ -x "$HOME/.local/bin/prime" && -x "$HOME/.local/bin/prime-agent" ]]
cp "$HOME/.local/bin/prime-agent" "$tmp/before"
# A second activation must not update or replace either installation.
bash "$repo_root/scripts/install-prime"
if [[ -n "${ACTIVATE_PRIME:-}" ]]; then
  bash "$ACTIVATE_PRIME"
fi
[[ "$(wc -l <"$TEST_LOG" | tr -d '[:space:]')" == 3 ]]
cmp "$tmp/before" "$HOME/.local/bin/prime-agent"

# A failed download must not execute an installer or leave a temp file.
rm "$HOME/.local/bin/prime-agent"
if TEST_DOWNLOAD_FAIL=1 bash "$repo_root/scripts/install-prime"; then
  echo "A failed download must fail installation" >&2
  exit 1
fi
[[ ! -e "$HOME/.local/bin/prime-agent" ]]
if compgen -G "$tmp/tmp.*"; then
  echo "Installation left a temporary download" >&2
  exit 1
fi
bash "$repo_root/scripts/install-prime"
[[ -x "$HOME/.local/bin/prime-agent" ]]
echo "Prime bootstrap checks passed"
